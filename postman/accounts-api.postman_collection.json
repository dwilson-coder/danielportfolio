              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"created.by.admin@example.com\",\n  \"password\": \"{{signupPassword}}\",\n  \"displayName\": \"Created by admin\",\n  \"role\": \"user\",\n  \"status\": \"active\"\n}",
              "options": {
