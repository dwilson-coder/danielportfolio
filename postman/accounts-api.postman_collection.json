        },
        {
          "name": "Update user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200))",
                  "pm.test('Matches User schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"email\",\"displayName\",\"role\",\"status\",\"twoFactorEnabled\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"email\":{\"type\":\"string\",\"format\":\"email\",\"maxLength\":254},\"displayName\":{\"type\":\"string\",\"maxLength\":80},\"role\":{\"type\":\"string\",\"enum\":[\"user\",\"admin\"]},\"status\":{\"type\":\"string\",\"enum\":[\"active\",\"disabled\"]},\"twoFactorEnabled\":{\"type\":\"boolean\"},\"createdAt\":{\"type\":\"string\"}}}))"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated by admin\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{userId}}",
              "host": [
