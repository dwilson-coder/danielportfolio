    {
      "name": "4. Admin - users",
      "item": [
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200))",
                  "pm.test('Matches UserList schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"items\",\"total\",\"limit\",\"offset\"],\"properties\":{\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"email\",\"displayName\",\"role\",\"status\",\"twoFactorEnabled\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"email\":{\"type\":\"string\",\"format\":\"email\",\"maxLength\":254},\"displayName\":{\"type\":\"string\",\"maxLength\":80},\"role\":{\"type\":\"string\",\"enum\":[\"user\",\"admin\"]},\"status\":{\"type\":\"string\",\"enum\":[\"active\",\"disabled\"]},\"twoFactorEnabled\":{\"type\":\"boolean\"},\"createdAt\":{\"type\":\"string\"}}}},\"total\":{\"type\":\"integer\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}}}))",
                  "const found = pm.response.json().items.find(u => u.email === pm.environment.get('signupEmail'))",
                  "if (found) pm.environment.set('userId', found.id)"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25",
                  "disabled": false
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "active",
                  "disabled": true
                },
                {
                  "key": "role",
                  "value": "user",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "List users"
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201))",
