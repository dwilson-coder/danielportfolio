{
  "name": "danielportfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js --demo",
    "dev:web": "vite",
    "create-user": "node --env-file-if-exists=.env server/create-user.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test:api": "node scripts/run-postman.js",
    "postman:run": "node scripts/run-postman.js --newman",
    "postman:sync": "node scripts/sync-postman.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "newman": "^6.2.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
